# Public browser TEST configuration only. No Stytch secret or AgentID client secret here.
# Copy to ignored .env.local. Leave disabled until TEST connection registration is complete.
VITE_AGENTID_ENABLED=0
VITE_AGENTID_CONNECTION_ID=oidc-connection-test-REPLACE
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-REPLACE
VITE_STYTCH_ISSUER=https://REPLACE_TEST_CONNECTED_APPS_ISSUER
VITE_LME_REMOTE_BASE=http://localhost:8787
# VITE values are compiled into the browser bundle: restart dev/rebuild after changes.
